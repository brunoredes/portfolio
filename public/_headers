/*
  # CSP, HSTS, and COOP are set dynamically by functions/_middleware.ts
  # (per-request nonce injection via HTMLRewriter).
  # The static headers below complement the middleware-controlled ones.
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), interest-cohort=()
  Access-Control-Allow-Origin: https://donatelli.dev
  Access-Control-Allow-Methods: GET, POST, OPTIONS
  Access-Control-Allow-Headers: Content-Type
