{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "company": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "roleLevel": {
      "type": "string"
    },
    "startDate": {
      "type": "string"
    },
    "endDate": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "string",
          "const": "current"
        }
      ]
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "location": {
      "type": "string"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "company",
    "role",
    "roleLevel",
    "startDate",
    "endDate"
  ]
}