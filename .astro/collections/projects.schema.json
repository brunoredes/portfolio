{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "number": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "technologies": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "repoUrl": {
      "type": "string",
      "format": "uri"
    },
    "liveUrl": {
      "type": "string",
      "format": "uri"
    },
    "previewImg": {
      "type": "string"
    },
    "featured": {
      "default": false,
      "type": "boolean"
    },
    "$schema": {
      "type": "string"
    }
  },
  "required": [
    "number",
    "title",
    "description",
    "technologies",
    "repoUrl"
  ]
}