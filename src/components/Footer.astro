---
interface Props { variant?: 'home' | 'privacy'; }
const { variant = 'home' } = Astro.props;
---
<footer class="footer">
  <span>© 2026 donatelli.dev</span>
  {variant === 'privacy' ? (
    <span>LGPD nº 13.709/2018 · GDPR EU 2016/679</span>
  ) : (
    <>
      <div class="links">
        <a href="/privacy-policy">Privacidade</a>
        <span>Cookies</span>
      </div>
      <span>feito com <span class="coracao">♥</span> e Astro</span>
    </>
  )}
</footer>
