---
interface Props { variant?: 'home' | 'privacy'; }
const { variant = 'home' } = Astro.props;
---
<footer class="footer">
  <span>© 2026 donatelli.dev</span>
  {variant === 'privacy' ? (
    <span>LGPD nº 13.709/2018 · GDPR EU 2016/679</span>
  ) : (
    <>
      <div class="links">
        <a href="/privacy-policy">Privacidade</a>
        <a href="/accessibility">Acessibilidade</a>
        <button type="button" id="link-cookies" command="show-modal" commandfor="cookie-dialog" aria-haspopup="dialog" aria-expanded="false" style="background:none;border:0;padding:0;font:inherit;color:inherit;cursor:pointer">Cookies</button>
      </div>
      <span>feito com <span class="coracao">♥</span> e Astro</span>
    </>
  )}
</footer>
