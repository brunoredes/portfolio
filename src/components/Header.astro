---
interface Props { active?: 'home' | 'privacy' | 'accessibility'; }
const { active = 'home' } = Astro.props;
const homePrefix = active === 'home' ? '' : '/';
---
<header class="header">
  <a class="logo" href="/">donatelli<em>.dev</em></a>
  <nav class="nav">
    <a href={`${homePrefix}#sec-projetos`}>Projetos</a>
    <a href={`${homePrefix}#sec-trajetoria`}>Trajetória</a>
    <a href={`${homePrefix}#sec-artigos`}>Artigos</a>
    <a href="/privacy-policy" class:list={[{ ativo: active === 'privacy' }]} aria-current={active === 'privacy' ? 'page' : undefined}>Privacidade</a>
  </nav>
  <a class="btn-contato" href={`${homePrefix}#sec-contato`}>Contato</a>
  <button class="hamburger" id="btn-menu" aria-label="Abrir menu" aria-controls="menu-mobile" aria-expanded="false">
    <span></span><span></span><span></span>
  </button>
</header>

<nav class="menu-mobile" id="menu-mobile" aria-label="Navegação principal mobile" hidden>
  <a href={`${homePrefix}#sec-projetos`}>Projetos</a>
  <a href={`${homePrefix}#sec-trajetoria`}>Trajetória</a>
  <a href={`${homePrefix}#sec-artigos`}>Artigos</a>
  <a href="/privacy-policy" class:list={[{ ativo: active === 'privacy' }]}>Privacidade</a>
  <a class="btn-contato" href={`${homePrefix}#sec-contato`}>Contato</a>
</nav>

<script>
const ac = new AbortController();
const { signal } = ac;
const btnMenu = document.getElementById('btn-menu');
const menuMobile = document.getElementById('menu-mobile');
const updateMenuState = (aberto) => {
  btnMenu?.setAttribute('aria-expanded', String(aberto));
  btnMenu?.setAttribute('aria-label', aberto ? 'Fechar menu' : 'Abrir menu');

  if (aberto) {
    menuMobile?.removeAttribute('hidden');
    menuMobile?.classList.add('aberto');
    return;
  }

  menuMobile?.classList.remove('aberto');
  menuMobile?.setAttribute('hidden', '');
};

btnMenu?.addEventListener('click', () => {
  const aberto = !(menuMobile?.classList.contains('aberto') ?? false);
  updateMenuState(aberto);
}, { signal });
menuMobile?.querySelectorAll('a').forEach((a) =>
  a.addEventListener('click', () => {
    updateMenuState(false);
  }, { signal })
);

// Scrollspy: marca a seção visível com aria-current="page" nos links de navegação.
// Só age nos links âncora da própria página (href="#..."); nas outras páginas
// os links apontam para "/#..." e são ignorados.
const spyLinks = [...document.querySelectorAll('.nav a[href^="#"], .menu-mobile a[href^="#"]')];
const secoesSpy = [...new Set(spyLinks.map((a) => document.getElementById(a.getAttribute('href').slice(1))).filter(Boolean))];

let spy;
if (secoesSpy.length) {
  spy = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      spyLinks.forEach((a) => {
        const ativo = a.getAttribute('href') === `#${entry.target.id}`;
        a.classList.toggle('ativo', ativo);
        if (ativo) a.setAttribute('aria-current', 'location');
        else a.removeAttribute('aria-current');
      });
    });
  }, { rootMargin: '-30% 0px -60% 0px' });
  secoesSpy.forEach((secao) => spy.observe(secao));
}

// Cleanup: solta listeners/observer ao sair (útil sob View Transitions; no-op em reload).
const teardown = () => { ac.abort(); spy?.disconnect(); };
window.addEventListener('pagehide', teardown, { once: true });
document.addEventListener('astro:before-swap', teardown, { once: true });
</script>
