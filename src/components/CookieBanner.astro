<dialog class="cookie-banner" id="cookie-dialog" aria-labelledby="cookie-titulo">
  <div class="topo">
    <strong class="titulo" id="cookie-titulo">Cookies por aqui<span class="ponto-laranja" aria-hidden="true">.</span></strong>
    <span class="badge-lgpd">LGPD</span>
  </div>
  <p>Uso apenas o <strong>Google Analytics</strong> (anônimo) para entender como o site é usado. Suas preferências de acessibilidade ficam só no seu navegador.</p>
  <div class="acoes">
    <button type="button" class="btn-aceitar" id="btn-aceitar">Aceitar análises</button>
    <button type="button" class="btn-essenciais" id="btn-essenciais">Não quero 🍪</button>
    <a class="link-politica" href="/privacy-policy">política →</a>
  </div>
</dialog>

<button type="button" class="cookie-fab" command="show-modal" commandfor="cookie-dialog" aria-label="Preferências de cookies" aria-haspopup="dialog" aria-expanded="false">🍪</button>

<script>
const GA_ID = import.meta.env.PUBLIC_GA_TAG;
const KEY = 'cookie-consent';
const dialog = document.getElementById('cookie-dialog') as HTMLDialogElement | null;

function loadGA() {
  if (!GA_ID || (window as any).__gaLoaded) return;
  (window as any).__gaLoaded = true;
  const s = document.createElement('script');
  s.async = true;
  s.src = `https://www.googletagmanager.com/gtag/js?id=${GA_ID}`;
  document.head.appendChild(s);
  (window as any).dataLayer = (window as any).dataLayer || [];
  (window as any).gtag = function () { (window as any).dataLayer.push(arguments); };
  (window as any).gtag('js', new Date());
  (window as any).gtag('config', GA_ID, { anonymize_ip: true, cookie_flags: 'SameSite=None;Secure' });
}

function revokeGA() {
  if ((window as any).gtag) (window as any).gtag('consent', 'update', { analytics_storage: 'denied' });
}

if (dialog) {
  const ac = new AbortController();
  const { signal } = ac;
  const status = localStorage.getItem(KEY);
  if (!status) dialog.showModal();
  else if (status === 'accepted') loadGA();

  document.getElementById('btn-aceitar')?.addEventListener('click', () => {
    localStorage.setItem(KEY, 'accepted');
    loadGA();
    dialog.close();
  }, { signal });
  document.getElementById('btn-essenciais')?.addEventListener('click', () => {
    localStorage.setItem(KEY, 'rejected');
    revokeGA();
    dialog.close();
  }, { signal });

  // Mantém aria-expanded dos gatilhos em sincronia com o estado do <dialog>.
  // Cobre todos os caminhos: command API, fallback, abertura automática e Esc.
  const gatilhos = [
    document.querySelector('.cookie-fab'),
    document.getElementById('link-cookies'),
  ].filter(Boolean) as HTMLElement[];
  const syncExpanded = () => gatilhos.forEach((t) => t.setAttribute('aria-expanded', String(dialog.open)));
  const mo = new MutationObserver(syncExpanded);
  mo.observe(dialog, { attributes: true, attributeFilter: ['open'] });
  syncExpanded();

  // Fallback for browsers without the Invoker Commands API (command/commandfor)
  if (!('command' in HTMLButtonElement.prototype)) {
    document.querySelector('.cookie-fab')?.addEventListener('click', () => dialog.showModal(), { signal });
    document.getElementById('link-cookies')?.addEventListener('click', () => dialog.showModal(), { signal });
  }

  // Cleanup: solta listeners/observer ao sair (útil sob View Transitions; no-op em reload).
  const teardown = () => { ac.abort(); mo.disconnect(); };
  window.addEventListener('pagehide', teardown, { once: true });
  document.addEventListener('astro:before-swap', teardown, { once: true });
}
</script>
