        <a class="rede" href="#">linkedin ↗</a>
      </div>
    </div>

    <form class="formulario" id="form-contato" novalidate>
      <div class="campo" id="campo-nome">
        <label for="nome">Nome completo <em>*</em></label>
        <input type="text" id="nome" name="nome" placeholder="Como você se chama?">
        <span class="erro">Me diz seu nome :)</span>
      </div>
      <div class="campo" id="campo-assunto">
        <label for="assunto">Assunto <em>*</em></label>
        <input type="text" id="assunto" name="assunto" placeholder="Sobre o que vamos falar?">
        <span class="erro">Qual é o assunto?</span>
      </div>
      <div class="campo" id="campo-mensagem">
        <label for="mensagem">Mensagem <em>*</em></label>
        <textarea id="mensagem" name="mensagem" rows="4" placeholder="Conta tudo..."></textarea>
        <span class="erro">Conta um pouco mais — pelo menos 10 caracteres.</span>
      </div>
      <button type="submit" class="btn-primario">Enviar mensagem →</button>
    </form>

    <div class="sucesso" id="sucesso">
      <div class="check">✓</div>
      <h3>Mensagem enviada!</h3>
      <p>Valeu, <span id="primeiro-nome">você</span> — respondo em até 48h.</p>
