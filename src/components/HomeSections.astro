---
import { getCollection, render } from 'astro:content';

const [projects, experiences, blogPosts] = await Promise.all([
	getCollection('projects'),
	getCollection('experience'),
	getCollection('blog'),
]);

const sortedProjects = projects.sort((a, b) => a.data.number.localeCompare(b.data.number));
const sortedExperiences = experiences.sort((a, b) => b.data.startDate.localeCompare(a.data.startDate));
const latestBlogPosts = blogPosts.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf()).slice(0, 3);
const renderedProjects = await Promise.all(
	sortedProjects.map(async (project) => ({ ...project, Content: (await render(project)).Content })),
);
const renderedExperiences = await Promise.all(
	sortedExperiences.map(async (experience) => ({ ...experience, Content: (await render(experience)).Content })),
);
const renderedBlogPosts = await Promise.all(
	latestBlogPosts.map(async (post) => ({ ...post, Content: (await render(post)).Content })),
);

const formatPeriod = (startDate: string, endDate: string) =>
	`${startDate} — ${endDate === 'current' ? 'atual' : endDate}`;
const platformLabel = (language: string) => (language === 'pt-BR' ? 'BR' : 'US');
---
<div class="container">

  <!-- ================= Hero ================= -->
  <section class="hero">
    <div class="kicker">BRUNO DONATELLI</div>
    <h1>Criando experiências digitais <em>incríveis</em>.</h1>
    <p>Full stack · Angular · C# · arquiteturas escaláveis. Atualmente no Itaú Unibanco.</p>
    <div class="acoes">
      <a class="btn-primario" href="#sec-projetos">Ver projetos</a>
      <a class="btn-secundario" href="#">Currículo ↓</a>
    </div>
  </section>

  <!-- ================= Projetos ================= -->
  <section class="secao" id="sec-projetos">
    <h2>Projetos<span class="ponto-roxo" aria-hidden="true">.</span></h2>
    <div class="grid-projetos">
      {renderedProjects.map(({ data, Content }) => (
        <article class:list={["card-projeto", { destaque: data.featured }]}>
          <div class="topo">
            <span class="numero">{data.number}</span>
            {data.featured && <span class="badge-destaque">destaque</span>}
          </div>
          <div>
            <h3><a href={data.liveUrl ?? data.repoUrl} aria-label={`Link para ${data.title} - Abre em nova guia`} target="_blank" rel="noopener noreferrer">{data.title}</a></h3>
            <Content />
            <div class="tags">
              {data.technologies.map((technology: string) => <span class="tag">{technology.toLowerCase()}</span>)}
            </div>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= Trajetória + Stack ================= -->
  <section class="secao" id="sec-trajetoria">
    <div class="grid-duplo">

      <div class="card-bloco">
        <h2>Trajetória<span class="ponto-laranja" aria-hidden="true">.</span></h2>
        {renderedExperiences.map(({ data, Content }, index) => (
          <div class:list={["timeline-item", { "trajetoria-extra": index > 0 }]} id={index === 1 ? 'trajetoria-extra' : undefined}>
            <div class="timeline-eixo" aria-hidden="true">
              <div class:list={["timeline-ponto", { passado: index > 0 }]}></div>
              {index < renderedExperiences.length - 1 && <div class="timeline-linha"></div>}
            </div>
            <div class="timeline-corpo">
              <div class="timeline-titulo">
                <strong>{data.company}</strong>
                {data.endDate === 'current' && <span class="badge-atual">ATUAL</span>}
              </div>
              <div class="timeline-meta">
                {data.role} {data.roleLevel} · {formatPeriod(data.startDate, data.endDate)}
                {data.location && <> · {data.location}</>}
              </div>
              <Content />
            </div>
          </div>
        ))}
        {renderedExperiences.length > 1 && <button class="link-expandir" id="btn-expandir" aria-expanded="false" aria-controls="trajetoria-extra">ver tudo →</button>}
      </div>

      <div class="card-bloco">
        <h2>Stack<span class="ponto-roxo" aria-hidden="true">.</span></h2>
        <div class="chips-stack">
          <span class="chip principal">Angular</span>
          <span class="chip principal">TypeScript</span>
          <span class="chip">React</span>
          <span class="chip">Node.js</span>
          <span class="chip">C#</span>
          <span class="chip">Docker</span>
          <span class="chip">PostgreSQL</span>
          <span class="chip">SCSS</span>
          <span class="chip">Git</span>
        </div>
        <p class="legenda-stack">roxo = primeira língua</p>
      </div>

    </div>
  </section>

  <!-- ================= Publicações ================= -->
  <section class="secao" id="sec-artigos">
    <div class="secao-cabecalho">
      <h2>Publicações<span class="ponto-laranja" aria-hidden="true">.</span></h2>
      <a class="link-externo" href="https://dev.to/brunoredes" target="_blank" rel="noopener noreferrer" aria-label="dev.to e Medium (abre em nova aba)">dev.to + medium ↗</a>
    </div>
    <div class="grid-artigos">
      {renderedBlogPosts.map(({ data, Content }) => (
        <article class="card-artigo">
          <div class="meta">
            <div class="fontes">
              {data.platforms.map((platform) => (
                <a class="fonte" href={platform.url}>{platform.name} · {platformLabel(platform.language)}</a>
              ))}
            </div>
            <time class="quando" datetime={data.date.toISOString()}>{data.date.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' })}</time>
          </div>
          <h3>{data.title}</h3>
          <Content />
          <a class="ler-artigo" href={data.platforms[0].url} target="_blank" rel="noopener noreferrer" aria-label={`Ler artigo: ${data.title} (abre em nova aba)`}>ler artigo →</a>
        </article>
      ))}
    </div>
  </section>

  <!-- ================= Contato ================= -->
  <section class="contato" id="sec-contato">

    <div class="contato-intro">
      <div class="kicker">CONTATO</div>
      <h2>Bora construir algo<span class="ponto-laranja" aria-hidden="true">?</span></h2>
      <p>Projetos, dúvidas de Angular ou um convite para palestrar — respondo rápido.</p>
      <div class="redes">
        <a class="rede" href="https://github.com/brunoredes" target="_blank" rel="noopener noreferrer" aria-label="GitHub (abre em nova aba)">github ↗</a>
        <a class="rede" href="https://linkedin.com/in/brunoldonatelli" target="_blank" rel="noopener noreferrer" aria-label="LinkedIn (abre em nova aba)">linkedin ↗</a>
      </div>
    </div>

    <form class="formulario" id="form-contato" novalidate>
      <div class="campo" id="campo-nome">
        <label for="nome">Nome completo <em aria-hidden="true">*</em></label>
        <input type="text" id="nome" name="nome" placeholder="Como você se chama?" required aria-required="true" aria-describedby="erro-nome">
        <span class="erro" id="erro-nome" role="alert">Me diz seu nome :)</span>
      </div>
      <div class="campo" id="campo-assunto">
        <label for="assunto">Assunto <em aria-hidden="true">*</em></label>
        <input type="text" id="assunto" name="assunto" placeholder="Sobre o que vamos falar?" required aria-required="true" aria-describedby="erro-assunto">
        <span class="erro" id="erro-assunto" role="alert">Qual é o assunto?</span>
      </div>
      <div class="campo" id="campo-mensagem">
        <label for="mensagem">Mensagem <em aria-hidden="true">*</em></label>
        <textarea id="mensagem" name="mensagem" rows="4" placeholder="Conta tudo..." required aria-required="true" aria-describedby="erro-mensagem"></textarea>
        <span class="erro" id="erro-mensagem" role="alert">Conta um pouco mais — pelo menos 10 caracteres.</span>
      </div>
      <button type="submit" class="btn-primario" id="btn-enviar">Enviar mensagem →</button>
      <p class="form-erro" id="form-erro" role="alert" hidden>Não consegui enviar agora — tenta de novo ou me chama no LinkedIn.</p>
    </form>

    <div class="sucesso" id="sucesso" role="status" aria-live="polite" tabindex="-1">
      <div class="check" aria-hidden="true">✓</div>
      <h3>Mensagem enviada!</h3>
      <p>Valeu, <span id="primeiro-nome">você</span> — respondo em até 48h.</p>
      <button class="reenviar" id="btn-reenviar">enviar outra mensagem</button>
    </div>

  </section>
</div>
