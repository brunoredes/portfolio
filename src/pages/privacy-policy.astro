---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/main.scss';

const siteUrl = 'https://donatelli.dev';
const title = 'Política de privacidade — donatelli.dev';
const description = 'Política de privacidade do portfólio donatelli.dev, com informações sobre cookies essenciais, analytics opcional, direitos LGPD/GDPR e contato.';
const questions = [
	{
		question: 'Quais dados o donatelli.dev coleta?',
		answer: 'O site usa preferências locais essenciais e só envia dados de análise quando o visitante consente explicitamente.',
	},
	{
		question: 'Como controlar cookies no donatelli.dev?',
		answer: 'O visitante pode aceitar apenas cookies essenciais, consentir analytics opcional ou revogar preferências limpando os dados locais do navegador.',
	},
];
const privacySchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${siteUrl}/privacy-policy#webpage`,
	url: `${siteUrl}/privacy-policy`,
	name: title,
	description,
	inLanguage: 'pt-BR',
	isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website` },
	about: ['Política de privacidade', 'LGPD', 'GDPR', 'Cookies essenciais', 'Analytics opcional'],
	dateModified: '2026-02-14',
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: questions.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical="/privacy-policy"
      robots="index, follow, max-image-preview:large"
      openGraph={{ type: 'article', title, description, url: '/privacy-policy' }}
      twitter={{ title, description }}
      jsonLd={[privacySchema, faqSchema]}
    />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <Header active="privacy" />
    <main id="main-content">
      <div class="container">

  <!-- ================= Cabeçalho da página ================= -->
  <div class="pagina-header">
    <div class="kicker">PRIVACIDADE · LGPD / GDPR</div>
    <h1>Política de privacidade<span class="ponto-laranja" aria-hidden="true">.</span></h1>
    <span class="atualizacao">última atualização — 14 fev 2026</span>
  </div>

  <!-- ================= Sumário + Seções ================= -->
  <div class="corpo">

    <nav class="sumario" id="sumario" aria-label="Nesta página">
      <span class="titulo">NESTA PÁGINA</span>
      <a href="#s01">01 · Introdução</a>
      <a href="#s02">02 · Dados coletados</a>
      <a href="#s03">03 · Como usamos</a>
      <a href="#s04">04 · Terceiros</a>
      <a href="#s05">05 · Seus direitos</a>
      <a href="#s06">06 · Armazenamento</a>
      <a href="#s07">07 · Controlar cookies</a>
      <a href="#s08">08 · Links externos</a>
      <a href="#s09">09 · Alterações</a>
      <a href="#s10">10 · Contato</a>
    </nav>

    <div class="secoes">
      <h2 style="position:absolute;width:1px;height:1px;margin:-1px;padding:0;overflow:hidden;clip:rect(0 0 0 0);white-space:nowrap;border:0">Seções da política de privacidade</h2>

      <article class="card-secao" id="s01">
        <div class="cabecalho">
          <span class="numero">01</span>
          <h3>Introdução</h3>
        </div>
        <p>Este site é um portfólio pessoal e não coleta, armazena ou processa dados pessoais identificáveis, exceto quando você explicitamente concorda com o uso de cookies de análise (Google Analytics).</p>
        <p>Esta política descreve como suas informações são tratadas quando você visita este site.</p>
      </article>

      <article class="card-secao" id="s02">
        <div class="cabecalho">
          <span class="numero">02</span>
          <h3>Dados coletados</h3>
        </div>
        <h4>2.1 Cookies essenciais</h4>
        <p>Este site utiliza <strong>localStorage</strong> do navegador para armazenar suas preferências de acessibilidade (tamanho de fonte, contraste, esquema de cores, etc.) e sua escolha sobre cookies.</p>
        <p>Essas informações permanecem apenas no seu dispositivo e não são enviadas para nenhum servidor.</p>
        <h4>2.2 Cookies de análise (opcional)</h4>
        <p>Quando você <strong>aceita cookies de análise</strong>, utilizamos o <strong>Google Analytics</strong> para entender como visitantes interagem com o site. Os dados coletados incluem:</p>
        <ul class="bullet-list">
          <li>Páginas visitadas e tempo de permanência</li>
          <li>Tipo de dispositivo e navegador utilizado</li>
          <li>Localização aproximada (cidade/região, com IP anonimizado)</li>
          <li>Origem do tráfego (como você chegou ao site)</li>
        </ul>
        <div class="nota">
          <span class="rotulo">importante</span>
          <span>Os endereços IP são anonimizados e não armazenamos informações que possam identificá-lo pessoalmente.</span>
        </div>
      </article>

      <article class="card-secao" id="s03">
        <div class="cabecalho">
          <span class="numero">03</span>
          <h3>Como usamos</h3>
        </div>
        <p>Os dados coletados são utilizados exclusivamente para:</p>
        <ul class="bullet-list">
          <li><strong>Preferências de acessibilidade:</strong> lembrar suas configurações de acessibilidade para melhorar sua experiência de navegação.</li>
          <li><strong>Análise de tráfego:</strong> entender como visitantes usam o site para melhorar o conteúdo e a experiência do usuário, apenas se você aceitar cookies de análise.</li>
        </ul>
        <p><strong>Não vendemos, compartilhamos ou alugamos seus dados</strong> para terceiros para fins de marketing ou publicidade.</p>
      </article>

      <article class="card-secao" id="s04">
        <div class="cabecalho">
          <span class="numero">04</span>
          <h3>Terceiros</h3>
        </div>
        <h4>4.1 Google Analytics</h4>
        <p>Se você aceitar cookies de análise, utilizamos o Google Analytics 4 (GA4) para análise de tráfego. O Google Analytics coleta dados de forma anônima e está sujeito à <a href="https://policies.google.com/privacy" target="_blank" rel="noopener noreferrer" class="privacy-link">Política de Privacidade do Google</a>.</p>
        <h4>4.2 Cloudflare Pages</h4>
        <p>Este site é hospedado pela Cloudflare Pages. A Cloudflare pode coletar logs de acesso (endereços IP, cabeçalhos HTTP) para fins de segurança e performance. Consulte a <a href="https://www.cloudflare.com/privacypolicy/" target="_blank" rel="noopener noreferrer" class="privacy-link">Política de Privacidade da Cloudflare</a>.</p>
      </article>

      <article class="card-secao" id="s05">
        <div class="cabecalho">
          <span class="numero">05</span>
          <h3>Seus direitos (LGPD/GDPR)</h3>
        </div>
        <p>De acordo com a Lei Geral de Proteção de Dados (LGPD) e o GDPR, você tem o direito de:</p>
        <div class="grid-direitos">
          <div class="direito">
            <span class="ponto" aria-hidden="true"></span>
            <span><strong>Acessar</strong> suas informações armazenadas localmente (configurações de acessibilidade)</span>
          </div>
          <div class="direito">
            <span class="ponto" aria-hidden="true"></span>
            <span><strong>Corrigir</strong> ou <strong>excluir</strong> suas preferências a qualquer momento</span>
          </div>
          <div class="direito">
            <span class="ponto" aria-hidden="true"></span>
            <span><strong>Revogar consentimento</strong> para cookies de análise através das configurações de cookies</span>
          </div>
          <div class="direito">
            <span class="ponto" aria-hidden="true"></span>
            <span><strong>Solicitar exclusão</strong> de dados no Google Analytics (entre em contato)</span>
          </div>
        </div>
        <p>Para exercer esses direitos ou fazer perguntas sobre privacidade, entre em contato através do <a href="/#sec-contato" class="privacy-link">formulário de contato</a>.</p>
      </article>

      <article class="card-secao" id="s06">
        <div class="cabecalho">
          <span class="numero">06</span>
          <h3>Armazenamento</h3>
        </div>
        <h4>6.1 Armazenamento local</h4>
        <p>Suas preferências de acessibilidade e consentimento de cookies são armazenados exclusivamente no <strong>localStorage do seu navegador</strong>.</p>
        <p>Você pode limpar esses dados a qualquer momento através das configurações do navegador.</p>
        <h4>6.2 Dados do Google Analytics</h4>
        <p>Os dados coletados pelo Google Analytics são armazenados nos servidores do Google, com retenção de dados configurada para <strong>2 meses</strong>. Após esse período, os dados são automaticamente excluídos.</p>
      </article>

      <article class="card-secao" id="s07">
        <div class="cabecalho">
          <span class="numero">07</span>
          <h3>Controlar cookies</h3>
        </div>
        <p>Você pode gerenciar suas preferências de cookies de várias formas:</p>
        <ul class="bullet-list">
          <li><strong>Banner de cookies:</strong> aceite ou rejeite cookies de análise quando visitar o site pela primeira vez.</li>
          <li><strong>Configurações do navegador:</strong> a maioria dos navegadores permite bloquear ou excluir cookies através das configurações.</li>
          <li><strong>Opt-out do Google Analytics:</strong> instale o <a href="https://tools.google.com/dlpage/gaoptout" target="_blank" rel="noopener noreferrer" class="privacy-link">complemento de opt-out do navegador</a>.</li>
        </ul>
      </article>

      <article class="card-secao" id="s08">
        <div class="cabecalho">
          <span class="numero">08</span>
          <h3>Links externos</h3>
        </div>
        <p>Este site contém links para plataformas externas (GitHub, LinkedIn, dev.to, Medium).</p>
        <p>Não somos responsáveis pelas práticas de privacidade desses sites. Recomendamos que você leia as políticas de privacidade de cada plataforma que visitar.</p>
      </article>

      <article class="card-secao" id="s09">
        <div class="cabecalho">
          <span class="numero">09</span>
          <h3>Alterações</h3>
        </div>
        <p>Podemos atualizar esta política de privacidade ocasionalmente. Quaisquer alterações serão publicadas nesta página com uma data de "última atualização" revisada.</p>
        <p>Recomendamos que você revise esta política periodicamente para se manter informado sobre como protegemos suas informações.</p>
      </article>

      <article class="card-secao" id="s10">
        <div class="cabecalho">
          <span class="numero">10</span>
          <h3>Contato</h3>
        </div>
        <p>Para dúvidas, solicitações ou preocupações sobre esta política de privacidade, entre em contato através de:</p>
        <ul class="bullet-list">
          <li><strong>Formulário de contato:</strong> <a href="/#sec-contato" class="privacy-link">donatelli.dev</a></li>
          <li><strong>LinkedIn:</strong> <a href="https://linkedin.com/in/brunoldonatelli" target="_blank" rel="noopener noreferrer" class="privacy-link">linkedin.com/in/brunoldonatelli</a></li>
        </ul>
        <div class="nota">
          <span class="rotulo">conformidade</span>
          <span>Esta política está em conformidade com a Lei Geral de Proteção de Dados (LGPD - Lei nº 13.709/2018) e o Regulamento Geral de Proteção de Dados (GDPR - EU 2016/679).</span>
        </div>
      </article>

    </div>
  </div>

      </div>
    </main>
    <CookieBanner />
    <Footer variant="privacy" />
    <script is:inline>
// ===== Sumário: destaca a seção visível =====
const linksSumario = [...document.querySelectorAll('.sumario a')];
const secoes = linksSumario
  .map(a => document.querySelector(a.getAttribute('href')))
  .filter(Boolean);

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    linksSumario.forEach(a => {
      const ativo = a.getAttribute('href') === '#' + entry.target.id;
      a.classList.toggle('ativo', ativo);
      if (ativo) a.setAttribute('aria-current', 'location');
      else a.removeAttribute('aria-current');
    });
  });
}, { rootMargin: '-30% 0px -60% 0px' });

secoes.forEach(s => observer.observe(s));

// Cleanup: desconecta o observer ao sair (útil sob View Transitions; no-op em reload).
const teardown = () => observer.disconnect();
window.addEventListener('pagehide', teardown, { once: true });
document.addEventListener('astro:before-swap', teardown, { once: true });
    </script>
  </body>
</html>
