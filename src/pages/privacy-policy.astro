---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import '../styles/main.scss';

const siteUrl = 'https://donatelli.dev';
const title = 'Política de privacidade — donatelli.dev';
const description = 'Política de privacidade do portfólio donatelli.dev, com informações sobre cookies essenciais, analytics opcional, direitos LGPD/GDPR e contato.';
const questions = [
	{
		question: 'Quais dados o donatelli.dev coleta?',
		answer: 'O site usa preferências locais essenciais e só envia dados de análise quando o visitante consente explicitamente.',
	},
	{
		question: 'Como controlar cookies no donatelli.dev?',
		answer: 'O visitante pode aceitar apenas cookies essenciais, consentir analytics opcional ou revogar preferências limpando os dados locais do navegador.',
	},
];
const privacySchema = {
	'@context': 'https://schema.org',
	'@type': 'WebPage',
	'@id': `${siteUrl}/privacy-policy#webpage`,
	url: `${siteUrl}/privacy-policy`,
	name: title,
	description,
	inLanguage: 'pt-BR',
	isPartOf: { '@type': 'WebSite', '@id': `${siteUrl}/#website` },
	about: ['Política de privacidade', 'LGPD', 'GDPR', 'Cookies essenciais', 'Analytics opcional'],
	dateModified: '2026-02-14',
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: questions.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical="/privacy-policy"
      robots="index, follow, max-image-preview:large"
      summary="Resumo da política de privacidade do donatelli.dev, incluindo cookies, analytics opcional e direitos do visitante."
      expertise={["Privacidade web", "LGPD", "GDPR", "Cookies", "Analytics"]}
      serviceArea="Brasil e União Europeia quando aplicável"
      questions={questions}
      openGraph={{ type: 'article', title, description, url: '/privacy-policy' }}
      twitter={{ card: 'summary', title, description }}
      jsonLd={[privacySchema, faqSchema]}
    />
  </head>
  <body>
    <Header active="privacy" />
<div class="container">

  <!-- ================= Cabeçalho da página ================= -->
  <div class="pagina-header">
    <div class="kicker">PRIVACIDADE · LGPD / GDPR</div>
    <h1>Política de privacidade<span class="ponto-laranja">.</span></h1>
    <span class="atualizacao">última atualização — 14 fev 2026</span>
  </div>

  <!-- ================= Sumário + Seções ================= -->
  <div class="corpo">

    <aside class="sumario" id="sumario">
      <span class="titulo">NESTA PÁGINA</span>
      <a href="#s01">01 · Introdução</a>
      <a href="#s02">02 · Dados coletados</a>
      <a href="#s03">03 · Como usamos</a>
      <a href="#s04">04 · Terceiros</a>
      <a href="#s05">05 · Seus direitos</a>
      <a href="#s06">06 · Armazenamento</a>
      <a href="#s07">07 · Controlar cookies</a>
      <a href="#s08">08 · Links externos</a>
      <a href="#s09">09 · Alterações</a>
      <a href="#s10">10 · Contato</a>
    </aside>

    <div class="secoes">

      <article class="card-secao" id="s01">
        <div class="cabecalho">
          <span class="numero">01</span>
          <h3>Introdução</h3>
        </div>
        <p>Este site é um portfólio pessoal e não coleta dados pessoais identificáveis, exceto quando você concorda explicitamente com cookies de análise (Google Analytics).</p>
      </article>

      <article class="card-secao" id="s02">
        <div class="cabecalho">
          <span class="numero">02</span>
          <h3>Dados coletados</h3>
        </div>
        <p><strong>Essenciais:</strong> localStorage para preferências de acessibilidade e escolha de cookies — nada sai do seu dispositivo. <strong>Análise (opcional):</strong> páginas visitadas, dispositivo, região aproximada e origem do tráfego.</p>
        <div class="nota">
          <span class="rotulo">nota</span>
          <span>IPs são anonimizados; nada que possa te identificar é armazenado.</span>
        </div>
      </article>

      <article class="card-secao" id="s03">
        <div class="cabecalho">
          <span class="numero">03</span>
          <h3>Como usamos</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s04">
        <div class="cabecalho">
          <span class="numero">04</span>
          <h3>Terceiros</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s05">
        <div class="cabecalho">
          <span class="numero">05</span>
          <h3>Seus direitos (LGPD/GDPR)</h3>
        </div>
        <div class="grid-direitos">
          <div class="direito">
            <span class="ponto"></span>
            <span><strong>Acessar</strong> o que está armazenado localmente</span>
          </div>
          <div class="direito">
            <span class="ponto"></span>
            <span><strong>Corrigir ou excluir</strong> preferências a qualquer momento</span>
          </div>
          <div class="direito">
            <span class="ponto"></span>
            <span><strong>Revogar consentimento</strong> de análise quando quiser</span>
          </div>
          <div class="direito">
            <span class="ponto"></span>
            <span><strong>Solicitar exclusão</strong> de dados no Google Analytics</span>
          </div>
        </div>
      </article>

      <article class="card-secao" id="s06">
        <div class="cabecalho">
          <span class="numero">06</span>
          <h3>Armazenamento</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s07">
        <div class="cabecalho">
          <span class="numero">07</span>
          <h3>Controlar cookies</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s08">
        <div class="cabecalho">
          <span class="numero">08</span>
          <h3>Links externos</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s09">
        <div class="cabecalho">
          <span class="numero">09</span>
          <h3>Alterações</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

      <article class="card-secao" id="s10">
        <div class="cabecalho">
          <span class="numero">10</span>
          <h3>Contato</h3>
        </div>
        <div class="placeholder">[ conteúdo — migrar do site atual ]</div>
      </article>

    </div>
  </div>

</div>
    <Footer variant="privacy" />
    <script is:inline>
// ===== Sumário: destaca a seção visível =====
const linksSumario = [...document.querySelectorAll('.sumario a')];
const secoes = linksSumario
  .map(a => document.querySelector(a.getAttribute('href')))
  .filter(Boolean);

const observer = new IntersectionObserver((entries) => {
  entries.forEach(entry => {
    if (!entry.isIntersecting) return;
    linksSumario.forEach(a =>
      a.classList.toggle('ativo', a.getAttribute('href') === '#' + entry.target.id)
    );
  });
}, { rootMargin: '-30% 0px -60% 0px' });

secoes.forEach(s => observer.observe(s));
    </script>
  </body>
</html>
