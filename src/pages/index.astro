---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import SeoHead from '../components/SeoHead.astro';
import HomeSections from '../components/HomeSections.astro';
import CookieBanner from '../components/CookieBanner.astro';
import '../styles/main.scss';

const siteUrl = 'https://donatelli.dev';
const title = 'Bruno Donatelli — Full stack developer Angular, TypeScript e Node.js';
const description = 'Portfólio de Bruno Donatelli, full stack developer focado em Angular, TypeScript, Node.js, design systems e experiências digitais escaláveis.';
const questions = [
	{
		question: 'Quem é Bruno Donatelli?',
		answer: 'Bruno Donatelli é um full stack developer que cria aplicações web, interfaces escaláveis e soluções com Angular, TypeScript e Node.js.',
	},
	{
		question: 'Quais serviços aparecem neste portfólio?',
		answer: 'O portfólio destaca desenvolvimento frontend, arquitetura full stack, design systems, Node.js, Angular e criação de experiências digitais.',
	},
];
const personSchema = {
	'@context': 'https://schema.org',
	'@type': 'Person',
	'@id': `${siteUrl}/#person`,
	name: 'Bruno Donatelli',
	url: siteUrl,
	jobTitle: 'Full Stack Developer',
	worksFor: { '@type': 'Organization', name: 'BTG Pactual' },
	knowsAbout: ['Angular', 'TypeScript', 'Node.js', 'React', 'C#', 'Docker', 'PostgreSQL', 'SCSS', 'Design systems'],
	areaServed: ['Brasil', 'Remoto'],
};
const websiteSchema = {
	'@context': 'https://schema.org',
	'@type': 'WebSite',
	'@id': `${siteUrl}/#website`,
	url: siteUrl,
	name: 'donatelli.dev',
	description,
	inLanguage: 'pt-BR',
	publisher: { '@id': `${siteUrl}/#person` },
};
const profilePageSchema = {
	'@context': 'https://schema.org',
	'@type': 'ProfilePage',
	'@id': `${siteUrl}/#profile`,
	url: siteUrl,
	name: title,
	description,
	inLanguage: 'pt-BR',
	mainEntity: { '@id': `${siteUrl}/#person` },
	about: ['Projetos full stack', 'Trajetória profissional', 'Publicações técnicas', 'Contato profissional'],
};
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: questions.map(({ question, answer }) => ({
		'@type': 'Question',
		name: question,
		acceptedAnswer: { '@type': 'Answer', text: answer },
	})),
};
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title={title}
      description={description}
      canonical="/"
      summary="Portfólio de Bruno Donatelli com projetos, trajetória, stack e publicações sobre desenvolvimento web."
      expertise={["Angular", "TypeScript", "Node.js", "Design systems", "Full stack development"]}
      serviceArea="Brasil e remoto"
      questions={questions}
      openGraph={{ type: 'profile', title, description, url: '/' }}
      twitter={{ card: 'summary', title, description }}
      jsonLd={[personSchema, websiteSchema, profilePageSchema, faqSchema]}
    />
  </head>
  <body id="top">
    <a class="skip-link" href="#main-content">Pular para o conteúdo principal</a>
    <Header />
    <main id="main-content">
      <HomeSections />
    </main>
    <Footer />
    <CookieBanner />
    <script is:inline>
// ===== Trajetória: expandir/recolher =====
const btnExpandir = document.getElementById('btn-expandir');
const extras = document.querySelectorAll('.trajetoria-extra');
btnExpandir.addEventListener('click', () => {
  const aberto = !extras[0]?.classList.contains('aberto');
  extras.forEach((extra) => extra.classList.toggle('aberto', aberto));
  btnExpandir.textContent = aberto ? 'recolher ↑' : 'ver tudo →';
});

// ===== Formulário de contato =====
const form = document.getElementById('form-contato');
const sucesso = document.getElementById('sucesso');
form.addEventListener('submit', (e) => {
  e.preventDefault();
  const nome = document.getElementById('nome');
  const assunto = document.getElementById('assunto');
  const mensagem = document.getElementById('mensagem');
  let valido = true;

  const valida = (input, campoId, ok) => {
    document.getElementById(campoId).classList.toggle('invalido', !ok);
    if (!ok) valido = false;
  };
  valida(nome, 'campo-nome', !!nome.value.trim());
  valida(assunto, 'campo-assunto', !!assunto.value.trim());
  valida(mensagem, 'campo-mensagem', mensagem.value.trim().length >= 10);

  if (!valido) return;
  document.getElementById('primeiro-nome').textContent = nome.value.trim().split(' ')[0] || 'você';
  form.style.display = 'none';
  sucesso.classList.add('visivel');
});
['nome', 'assunto', 'mensagem'].forEach(id =>
  document.getElementById(id).addEventListener('input', () =>
    document.getElementById('campo-' + id).classList.remove('invalido'))
);
document.getElementById('btn-reenviar').addEventListener('click', () => {
  form.reset();
  form.style.display = '';
  sucesso.classList.remove('visivel');
});

// ===== Cookie banner (LGPD) =====
const banner = document.getElementById('cookie-banner');
if (!localStorage.getItem('dd-consent')) banner.classList.add('visivel');
document.getElementById('btn-aceitar').addEventListener('click', () => {
  localStorage.setItem('dd-consent', 'all');
  banner.classList.remove('visivel');
});
document.getElementById('btn-essenciais').addEventListener('click', () => {
  localStorage.setItem('dd-consent', 'essential');
  banner.classList.remove('visivel');
});
document.getElementById('link-cookies').addEventListener('click', () => banner.classList.add('visivel'));
    </script>
  </body>
</html>
