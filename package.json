{
  "name": "donatelli-dev",
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.19.1"
  },
  "scripts": {
    "ng": "ng",
    "dev": "vite",
    "start": "npm run dev",
    "build": "vite build && rm -rf dist/analog/public/_worker.js && npx ngsw-config dist/client ngsw-config.json / && cp node_modules/@angular/service-worker/ngsw-worker.js dist/client/",
    "watch": "vite build --watch",
    "test": "vitest",
    "preview": "vite preview",
    "docker:local": "docker compose -f docker-compose.local.yml up -d --build"
  },
  "private": true,
  "dependencies": {
    "@analogjs/content": "^2.5.2",
    "@analogjs/router": "^2.5.2",
    "@angular/animations": "^21.2.7",
