    "jsdom": "^22.0.0",
    "lightningcss": "^1.31.1",
    "typescript": "~5.9.0",
    "vite": "^7.0.0",
    "vite-plugin-bundle-obfuscator": "^1.10.0",
    "vite-tsconfig-paths": "^4.2.0",
    "vitest": "^4.0.0"
