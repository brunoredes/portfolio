{
  "$schema": "./node_modules/@angular/service-worker/config/schema.json",
  "index": "/index.html",
  "assetGroups": [
    {
      "name": "app",
      "installMode": "prefetch",
      "resources": {
        "files": [
          "/favicon.ico",
          "/index.html",
          "/manifest.webmanifest",
          "/assets/*.js",
          "/assets/*.css"
        ]
      }
    },
    {
      "name": "assets",
      "installMode": "lazy",
      "updateMode": "prefetch",
      "resources": {
        "files": [
          "/hero/**/*",
          "/icons/**/*",
          "/techs/**/*",
          "/blog/**/*",
          "/**/*.svg",
          "/**/*.avif",
          "/**/*.webp",
          "/**/*.jpg",
          "/**/*.png",
          "/**/*.woff2"
        ]
      }
    }
  ]
}
